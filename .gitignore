# Local AI context — not part of the published site.
# The brand snapshot is private and lives only on disk (master copy in
# ../Workspace/brand-agent-system/). Don't commit it to the public Pages repo.
.claude/
brand-agent-system/

# Local QA artifacts — Playwright screenshots, traces, logs.
.qa/
.playwright-test/

# Firebase local caches/logs and private admin keys.
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
serviceAccount*.json
*-firebase-adminsdk-*.json

# Local environment files. js/firebase-env.js IS committed: it holds only the public
# Firebase web config, which the live forms need. Access is guarded by firestore.rules.
# Never commit service account keys or .env files.
.env
.env.*
!.env.example

# Local-only feedback dashboard. Do not publish this with the website.
local-feedback-viewer/

# Clipboard screenshot drop — Claude grabs pasted screenshots here.
_inbox/

# Resource gate: the live rules carry SHA-256 hashes of the unlock codes and
# stay local. firestore.rules.example is the tracked template without hashes.
firestore.rules
firestore.rules.backup-*
gate-codes.local.json
